{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "refine/codebase-graph.v1",
  "title": "CodebaseGraph",
  "description": "The evidence-backed graph of an actual repository. Produced by RefineHelper (src/analysis/types.ts), decoded by RefineCore (Models/CodebaseGraph.swift). Planned work never appears here.",
  "type": "object",
  "required": ["schemaVersion", "metadata", "nodes", "edges"],
  "$defs": {
    "verification": {
      "enum": ["confirmed", "inferred", "unknown"],
      "description": "confirmed = traceable to source evidence; inferred = heuristic (name or URL string match); unknown = could not be determined."
    },
    "sourceRef": {
      "type": "object",
      "required": ["path"],
      "properties": { "path": { "type": "string" }, "line": { "type": "integer", "minimum": 1 }, "detail": { "type": "string" } }
    },
    "componentType": { "enum": ["frontend", "api", "service", "database", "entry", "library", "test", "config", "external"] },
    "node": {
      "type": "object",
      "required": ["id", "name", "type", "path", "group", "files", "languages", "symbols", "routes", "evidence", "verification"],
      "properties": {
        "id": { "type": "string", "description": "mod:<dir> for modules, ext:<package> for external dependencies" },
        "name": { "type": "string" },
        "type": { "$ref": "#/$defs/componentType" },
        "path": { "type": "string" },
        "group": { "type": "string" },
        "files": { "type": "array", "items": { "type": "string" } },
        "languages": { "type": "array", "items": { "type": "string" } },
        "symbols": { "type": "array", "items": { "type": "object", "required": ["name", "kind", "path", "line"] } },
        "routes": { "type": "array", "items": { "type": "object", "required": ["method", "path", "source"] } },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/sourceRef" } },
        "verification": { "$ref": "#/$defs/verification" }
      }
    },
    "edge": {
      "type": "object",
      "required": ["id", "source", "target", "relation", "evidence", "verification"],
      "properties": {
        "id": { "type": "string", "description": "<source>-><target>:<relation>" },
        "source": { "type": "string" },
        "target": { "type": "string" },
        "relation": { "enum": ["imports", "calls-api", "uses-database", "depends-on"] },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/sourceRef" }, "description": "Every confirmed edge has at least one entry." },
        "verification": { "$ref": "#/$defs/verification" }
      }
    }
  },
  "properties": {
    "schemaVersion": { "const": 1 },
    "metadata": {
      "type": "object",
      "required": ["workspaceId", "analyzedAt", "snapshot", "supportedLanguages", "languages", "frameworks", "entryPoints", "warnings", "stats"],
      "properties": {
        "workspaceId": { "type": "string" },
        "analyzedAt": { "type": "string", "format": "date-time" },
        "snapshot": { "type": "object", "required": ["head", "branch", "dirty", "fingerprint"] },
        "supportedLanguages": { "type": "array", "items": { "type": "object", "required": ["name", "level"], "properties": { "level": { "enum": ["syntax", "pattern", "none"] } } } },
        "languages": { "type": "array" },
        "frameworks": { "type": "array" },
        "entryPoints": { "type": "array", "items": { "$ref": "#/$defs/sourceRef" } },
        "warnings": { "type": "array", "items": { "type": "string" } },
        "stats": { "type": "object", "required": ["files", "reparsed", "reused", "skipped"] }
      }
    },
    "nodes": { "type": "array", "items": { "$ref": "#/$defs/node" } },
    "edges": { "type": "array", "items": { "$ref": "#/$defs/edge" } }
  }
}
